{
  "profile": "RX400h_PROTOCOL_PROBE_V0_1",
  "purpose": "Validate the seven required signals and minimum energy-flow inputs without sending control commands.",
  "safety": {
    "read_only": true,
    "arbitrary_can_injection": false,
    "allowed_commands_only": true
  },
  "required_signals": [
    "soc_percent",
    "hv_battery_power_kw",
    "coolant_temp_c",
    "engine_rpm",
    "battery_temp_c",
    "aux_12v_v",
    "vehicle_speed_kph"
  ],
  "baseline_requests": [
    {"command": "ATRV", "purpose": "OBD adapter supply voltage", "priority": "required"},
    {"command": "0105", "purpose": "coolant temperature baseline", "priority": "required"},
    {"command": "010C", "purpose": "engine RPM baseline", "priority": "required"},
    {"command": "010D", "purpose": "vehicle speed baseline", "priority": "required"}
  ],
  "toyota_candidate_requests": [
    {"command": "2C01F3011060010110A0010210A0070210A1010210A1070210A2010210A207021067010210690302", "purpose": "define dynamic DID F301", "stage": "session_init"},
    {"command": "2C01F302103A0301103B0301103C030110A8010110A5010110A601011F460101", "purpose": "define dynamic DID F302", "stage": "session_init"},
    {"command": "22F3013", "payload": "22F301", "expected_response_count": 3, "purpose": "17-byte dynamic data block candidate"},
    {"command": "22F3022", "payload": "22F302", "expected_response_count": 2, "purpose": "7-byte temperature block candidate"},
    {"command": "2218147", "payload": "221814", "expected_response_count": 7, "purpose": "Toyota hybrid core data candidate"},
    {"command": "2210011", "payload": "221001", "expected_response_count": 1, "purpose": "auxiliary data candidate"},
    {"command": "2210021", "payload": "221002", "expected_response_count": 1, "purpose": "auxiliary data candidate"}
  ],
  "temperature_candidate": {
    "request": "22F302",
    "response_prefix": "62F302",
    "data_length_bytes": 7,
    "candidate_formula": "raw - 40",
    "display": ["T1", "T2", "T3", "T4", "T5", "T6", "RoomOrIntake"],
    "aggregates": ["max", "min", "average", "hottest_three_average", "delta"]
  },
  "logging": {
    "raw_io_jsonl": true,
    "decoded_jsonl": true,
    "frames_csv": true,
    "events_csv": true,
    "request_stats_csv": true,
    "connection_log": true,
    "flush_interval_ms": 1000,
    "flush_on_disconnect": true,
    "store_raw_response": true,
    "store_decoder_version": true,
    "store_source_bytes": true
  },
  "event_markers": [
    "COLD_START",
    "READY",
    "ENGINE_STARTED",
    "EV_MOVE",
    "LIGHT_ACCEL",
    "HARD_ACCEL",
    "COAST",
    "REGEN_BRAKE",
    "FRICTION_BRAKE",
    "HEATER_ON",
    "STOP"
  ],
  "open_questions": [
    "ICE/HSD/BATT request headers",
    "which ECU owns each F301 instance",
    "SOC/voltage/current byte positions and formulas",
    "ECU-side 12V voltage PID",
    "battery current sign convention",
    "minimum signals required for robust energy-flow state"
  ]
}
